# ============================================================
# .gitignore – SOC Platform
# ============================================================

# ------ Build / Release ------
dist/
build/
soc-agent/release/
soc-server/release/

# ------ Logs ------
*.log
logs/

# ------ TLS / Certificates (generated) ------
*.key
*.csr
*.srl
*.pem
*.crt
certs/

# ------ Node ------
node_modules/
soc-frontend/node_modules/

# ------ Python ------
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.mypy_cache/

# ------ Go binaries ------
*.exe
soc-agent/soc-agent
soc-server/soc-server

# ------ Environment / Secrets ------
.env
.env.*
!.env.example

# ------ Database dumps (too large / sensitive) ------
*.sql
*.db
*.sqlite3

# ------ IDE / OS ------
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ------ Temporary / Patch files ------
fix-frontend/
*.tmp
*.bak
*.patch

# ------ Postman / Test exports ------
*.json.bak