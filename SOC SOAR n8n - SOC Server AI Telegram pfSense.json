    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const domain = String($json.domain || new URL($json.url).hostname).toLowerCase().trim();\nif (!/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/.test(domain)) throw new Error('Tu choi domain khong hop le: ' + domain);\nconst sinkhole = '192.168.10.1';\nconst file = '/var/unbound/pfb_dnsbl_SOAR.conf';\nconst command = `grep -q \"${domain}\" ${file} 2>/dev/null || echo \"local-data: \\\"${domain} 60 IN A ${sinkhole}\\\"\" >> ${file}; /usr/local/sbin/pfSsh.php playback svc restart unbound`;\nreturn { json: { ...$json, domain, ssh_command: command } };"
