          { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "block_ip", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "Block IP" },
          { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "kill_process", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "Kill Process" },
          { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "block_url", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "Block URL" },
          { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "create_case", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "Create Case" },
          { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 }, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "isolate_host", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "Isolate Host" }
        ] },
        "options": { "fallbackOutput": "extra" }
