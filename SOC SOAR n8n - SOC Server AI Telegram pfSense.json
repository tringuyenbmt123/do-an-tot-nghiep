    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ip = String($json.src_ip || '').trim();\nconst ipv4 = /^(25[0-5]|2[0-4]\\d|1?\\d?\\d)(\\.(25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}$/;\nif (!ipv4.test(ip)) throw new Error('Tu choi IP khong hop le: ' + ip);\nreturn { json: { ...$json, ssh_command: `pfctl -t SOAR_BlockList -T add ${ip}` } };"
      },
