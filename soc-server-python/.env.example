# ==============================================================================
# SOC Server Python - Biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8080

# Database MySQL (chung với Go server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1
DB_NAME=soc_edr_db

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# n8n SOAR Webhook URLs
SOAR_ENABLED=true
N8N_WEBHOOK_URL=https://undegenerate-alisia-farsightedly.ngrok-free.dev/webhook/soc-alert
N8N_WEBHOOK_URL_DDOS=https://undegenerate-alisia-farsightedly.ngrok-free.dev/webhook/ddos-alert
N8N_WEBHOOK_URL_PHISHING=https://undegenerate-alisia-farsightedly.ngrok-free.dev/webhook/phishing-alert
N8N_WEBHOOK_URL_WAZUH=https://undegenerate-alisia-farsightedly.ngrok-free.dev/webhook/wazuh-critical-alert
SOAR_WEBHOOK_TIMEOUT=10
SOAR_MAX_RETRIES=3
SOAR_CALLBACK_SECRET=your-strong-random-secret-here

# Alert retention
ALERT_RETENTION_DAYS=7
